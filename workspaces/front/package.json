{
  "name": "front",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local react-router dev",
    "lint": "eslint . --fix && prettier --write .",
    "typecheck": "pnpm run typegen && react-router typegen && tsc -b",
    "typecheck:watch": "pnpm typecheck --watch",
    "deploy:dev": "CLOUDFLARE_ENV=dev pnpm run build && wrangler deploy",
    "deploy:prd": "CLOUDFLARE_ENV=prd pnpm run build && wrangler deploy",
    "build": "react-router build",
    "typegen": "wrangler types -e local --strict-vars=false",
    "postinstall": "npm run typegen",
    "preview": "pnpm run build && vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "hono": "^4.13.13",
    "i18next": "^26.5.6",
    "i18next-resources-to-backend": "^1.2.3",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.4",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
