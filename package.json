{
  "name": "cloudflare-todo",
  "version": "1.0.0",
  "scripts": {
    "b": "pnpm --filter \"back\" run",
    "f": "pnpm --filter \"front\" run",
    "e2e": "pnpm --filter \"e2e\" run",
    "postinstall": "pnpm typegen",
    "typegen": "pnpm b typegen && pnpm f typegen",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "typecheck": "pnpm typegen && vp check --no-fmt --no-lint",
    "test:unit": "pnpm -r test:unit",
    "test:api": "pnpm b test:api",
    "test:e2e": "pnpm b db:reset && pnpm e2e test",
    "check-all": "pnpm typegen && vp check && pnpm test:unit && pnpm test:api && pnpm test:e2e"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
